{
  "name": "btk-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Bow Tie Kreative — Astro front end for headless WordPress",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "mock": "node scripts/mock-wp.mjs",
    "mock:validate": "node scripts/mock-wp.mjs --validate",
    "dev:mock": "WP_GRAPHQL_ENDPOINT=http://localhost:8099/graphql astro dev",
    "build:mock": "WP_GRAPHQL_ENDPOINT=http://localhost:8099/graphql astro build"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "graphql": "^17.0.2",
    "typescript": "^6.0.3"
  }
}
