---
/**
 * Lead confirmation.
 *
 * Rendered on demand so it can show the lead's own grade back to them as a
 * response time — "today" for a hot lead is a promise we can keep, and one we
 * should not make to a cold one.
 *
 * Reachable with only the reference, which is why references are random rather
 * than sequential. Nothing sensitive is shown either way: no score, no grade
 * label, no contact details — just what happens next.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact, plans } from '../config';
import { fetchLead } from '../lib/leads';
import { nextSteps } from '../funnel';

export const prerender = false;

const reference = Astro.url.searchParams.get('ref') ?? '';
const lead = reference ? await fetchLead(reference) : null;

/**
 * The internal grade becomes an external promise. Deliberately conservative —
 * under-promising a callback costs nothing, over-promising one costs the lead.
 */
const when =
	lead?.grade === 'hot' ? 'today' : lead?.grade === 'warm' ? 'within a day' : 'shortly';

const growth = plans.find((plan) => plan.featured) ?? plans[1];
---

<BaseLayout
	title="Got it"
	description="Your details are in. I'll call you back."
	narrow
	sticky={false}
	seo={{ title: null, description: null, image: null, noindex: true }}
>
	<section class="section hero">
		<div class="wrap wrap--narrow">
			<p class="eyebrow">Message received</p>
			<h1>Got it.<br /><em class="accent">I’ll call you {when}.</em></h1>
			<p class="lede">
				Your answers are in front of me. If you’d rather not wait, call or text{' '}
				<a href={`tel:${contact.phoneRaw}`}>{contact.phone}</a> — that’s the fastest way to reach me,
				and you’ll get a person, not a queue.
			</p>
			{reference && <p class="mono ref">Reference: {reference}</p>}
		</div>
	</section>

	<section class="section section--concrete">
		<div class="wrap wrap--narrow">
			<h2 class="steps__heading">What happens next.</h2>
			<div class="grid">
				{
					nextSteps.map((step) => (
						<div class="card">
							<span class="card__index">{step.index}</span>
							<h3>{step.heading}</h3>
							<p>{step.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap wrap--narrow">
			<div class="panel panel--featured aside">
				<div class="panel__bar">
					<span>While you wait</span>
					<span>{growth.serial}</span>
				</div>
				<div class="aside__body">
					<h2>Worth a look before we talk.</h2>
					<p>
						Fourteen industries, fourteen different sites — open the one closest to your business and
						you’ll know in thirty seconds whether we build the kind of thing you want.
					</p>
					<div class="cta-row">
						<a class="btn btn--primary" href="/work">See the work →</a>
						<span class="mono">No sign-up, nothing gated.</span>
					</div>
				</div>
			</div>
			<p class="mono outro">
				Questions before the call? Call or text{' '}
				<a href={`tel:${contact.phoneRaw}`}>{contact.phone}</a>.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 56px 0 40px;
	}

	h1 {
		font-size: clamp(2.1rem, 6.5vw, 3.6rem);
	}

	.ref {
		margin: 18px 0 0;
	}

	.steps__heading {
		margin-bottom: 26px;
		font-size: clamp(1.6rem, 4vw, 2.3rem);
	}

	.aside {
		max-width: none;
	}

	.aside__body {
		padding: 28px 24px;
	}

	.aside__body h2 {
		margin: 0 0 12px;
		font-size: clamp(1.5rem, 4vw, 2.1rem);
	}

	.aside__body p {
		margin: 0 0 18px;
		color: var(--ink-2);
		max-width: 60ch;
	}

	.outro {
		margin: 26px 0 0;
		line-height: 1.8;
	}

	.outro a {
		color: var(--rust);
		font-weight: 700;
	}
</style>
