---
export const prerender = false;

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { ROLE_ADMIN, site } from '../../../config';
import { stripeConfigured } from '../../../lib/billing/stripe';
import { paypalConfigured } from '../../../lib/billing/paypal';
import { emailitConfigured } from '../../../lib/emailit/client';
import { envValue, siteMode } from '../../../lib/settings';

const user = Astro.locals.user!;
const isAdmin = user.roles.includes(ROLE_ADMIN);

const wpOrigin = (() => {
	try {
		return new URL(envValue('WP_GRAPHQL_ENDPOINT') || 'http://localhost:8080/graphql').origin;
	} catch {
		return 'http://localhost:8080';
	}
})();

// A live readout beats a static checklist: it tells you what is actually
// wired up on *this* server right now.
const [stripe, paypal, emailit, mode] = await Promise.all([
	stripeConfigured(),
	paypalConfigured(),
	emailitConfigured(),
	siteMode(),
]);

const checks = [
	{ label: 'WordPress API', ok: true, detail: wpOrigin },
	{ label: 'Auth shared secret', ok: envValue('WP_SHARED_SECRET').length > 0, detail: 'WP_SHARED_SECRET' },
	{ label: 'Stripe', ok: stripe, detail: 'Card subscriptions' },
	{ label: 'PayPal', ok: paypal, detail: 'PayPal subscriptions' },
	{ label: 'Emailit', ok: emailit, detail: 'Transactional + campaigns' },
];
---

<DashboardLayout title="Documentation" user={user}>
	<header class="dash__head">
		<h1>Documentation</h1>
		<p>How this site is put together, and how to test it.</p>
	</header>

	<nav class="panel" aria-label="Documentation sections">
		<p style="margin:0"><strong>On this page:</strong>
			<a href="#status">Status</a> ·
			<a href="#accounts">Accounts &amp; roles</a> ·
			<a href="#content">Editing content</a> ·
			<a href="#testing">Testing payments</a> ·
			<a href="#modes">Coming soon &amp; maintenance</a> ·
			<a href="#keys">API keys</a> ·
			<a href="/dashboard/docs/api">API reference →</a>
		</p>
	</nav>

	<div class="panel" id="status">
		<h2 class="panel__title">What's configured right now</h2>
		<div class="table-scroll">
			<table class="table">
				<tbody>
					{
						checks.map((check) => (
							<tr>
								<td style="width:12rem"><strong>{check.label}</strong></td>
								<td>
									<span class={`badge ${check.ok ? 'badge--active' : 'badge--none'}`}>
										{check.ok ? 'Configured' : 'Not set'}
									</span>
								</td>
								<td style="color:var(--ink-faint)">{check.detail}</td>
							</tr>
						))
					}
					<tr>
						<td><strong>Site mode</strong></td>
						<td>
							<span class={`badge ${mode.mode === 'live' ? 'badge--active' : 'badge--warn'}`}>
								{mode.mode === 'live' ? 'Live' : mode.mode.replace('_', ' ')}
							</span>
						</td>
						<td style="color:var(--ink-faint)">Settings → App Settings in WordPress</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p class="field__hint" style="margin-top:1rem">
			Anything marked "Not set" simply disables that feature — the dashboard says so in place rather than erroring.
		</p>
	</div>

	<div class="panel" id="accounts">
		<h2 class="panel__title">Accounts &amp; roles</h2>
		<p>
			WordPress owns every account. Create users, change roles and reset passwords in
			<a href={`${wpOrigin}/wp-admin/users.php`} target="_blank" rel="noopener noreferrer">wp-admin → Users</a> —
			there is no separate sign-up table to keep in sync.
		</p>
		<div class="table-scroll">
			<table class="table">
				<thead>
					<tr><th>Role</th><th>Can see</th></tr>
				</thead>
				<tbody>
					<tr>
						<td><strong>Administrator</strong></td>
						<td>Everything: Overview, Billing, Account, plus Marketing and Users</td>
					</tr>
					<tr>
						<td><strong>Subscriber / any other role</strong></td>
						<td>Overview, Billing, Account. Admin pages return 404, not 403.</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p class="field__hint">
			Sign in at <code>/login</code> with the same credentials as wp-admin. Sessions hold only your user id — roles
			and subscription are re-read from WordPress on every request, so a role change takes effect immediately.
		</p>
	</div>

	<div class="panel" id="content">
		<h2 class="panel__title">Editing content</h2>
		<p>
			Public pages are built from WordPress. Edit them in
			<a href={`${wpOrigin}/wp-admin/`} target="_blank" rel="noopener noreferrer">wp-admin</a>; the dev server
			picks changes up within about five seconds, and a production deploy rebuilds via the build hook.
		</p>
		<div class="table-scroll">
			<table class="table">
				<thead>
					<tr><th>In WordPress</th><th>On the site</th></tr>
				</thead>
				<tbody>
					<tr><td>Pages</td><td><code>/about</code>, nested paths preserved</td></tr>
					<tr><td>Posts</td><td><code>/blog/&lt;slug&gt;</code></td></tr>
					<tr><td>Work → Projects</td><td><code>/work/&lt;slug&gt;</code></td></tr>
					<tr><td>Services</td><td><code>/services/&lt;slug&gt;</code></td></tr>
					<tr><td>Testimonials</td><td>Rendered inside other pages</td></tr>
				</tbody>
			</table>
		</div>
		<p class="field__hint">
			The extra boxes below the editor (Project Details, Hero, SEO &amp; Social) are Meta Box fields. They are
			available over both GraphQL and REST — see the <a href="/dashboard/docs/api">API reference</a>.
		</p>
	</div>

	<div class="panel" id="testing">
		<h2 class="panel__title">Testing payments</h2>
		<p>Use test credentials — nothing here needs a real card.</p>

		<h3 style="font-size:var(--step-0);margin:1.25rem 0 0.5rem">Stripe</h3>
		<ol style="color:var(--ink-soft);font-size:var(--step--1)">
			<li>Put a <code>sk_test_…</code> key and two <code>price_…</code> ids in place (see below).</li>
			<li>
				Run <code>stripe listen --forward-to localhost:4321/api/billing/stripe-webhook</code> and paste the
				<code>whsec_…</code> it prints into <code>STRIPE_WEBHOOK_SECRET</code>.
			</li>
			<li>Go to <a href="/dashboard/billing">Billing</a> → <em>Pay with card</em>.</li>
			<li>Card <code>4242 4242 4242 4242</code>, any future expiry, any CVC.</li>
			<li>You land back on Billing. The plan appears once the webhook arrives — a second or two.</li>
		</ol>
		<p class="field__hint">
			If the plan never appears, the webhook is not reaching you. That is the whole mechanism: the redirect back
			from Stripe deliberately grants nothing, because a browser redirect can be faked.
		</p>

		<h3 style="font-size:var(--step-0);margin:1.25rem 0 0.5rem">PayPal</h3>
		<ol style="color:var(--ink-soft);font-size:var(--step--1)">
			<li>Keep <code>PAYPAL_ENV=sandbox</code>. Only the exact string <code>live</code> uses real money.</li>
			<li>Create a sandbox buyer account at developer.paypal.com → Sandbox → Accounts.</li>
			<li>
				Webhooks need a public URL — run <code>cloudflared tunnel --url http://localhost:4321</code> or ngrok, and
				register <code>&lt;tunnel&gt;/api/billing/paypal-webhook</code>.
			</li>
			<li>Billing → <em>Pay with PayPal</em>, approve with the sandbox buyer.</li>
		</ol>

		<h3 style="font-size:var(--step-0);margin:1.25rem 0 0.5rem">Without any keys</h3>
		<p style="color:var(--ink-soft);font-size:var(--step--1)">
			You can still exercise the rest of the flow. Ask an administrator to set a subscription directly:
		</p>
		<pre style="overflow-x:auto"><code>{`curl -X POST "${wpOrigin}/wp-json/app/v1/billing/<USER_ID>" \\
  -H "X-App-Secret: $WP_SHARED_SECRET" \\
  -H "Content-Type: application/json" \\
  -d '{"provider":"stripe","status":"active","plan":"studio"}'`}</code></pre>
	</div>

	<div class="panel" id="modes">
		<h2 class="panel__title">Coming soon &amp; maintenance</h2>
		<p>
			Set the site mode in
			<a href={`${wpOrigin}/wp-admin/options-general.php?page=app-settings`} target="_blank" rel="noopener noreferrer">
				Settings → App Settings
			</a>.
		</p>
		<p class="alert alert--ok" style="margin-bottom:1.25rem">
			<strong>How it applies.</strong> Public pages are prerendered, and prerendered files never reach the server's
			middleware — they are read straight off disk. So the gate is applied <em>at build time</em>: a build started
			while the mode is not Live turns every static page into the gate. Saving the setting fires the build hook to
			trigger that rebuild. Dynamic routes (<code>/login</code>, <code>/dashboard</code>, <code>/api</code>) and the
			whole of <code>astro dev</code> are gated immediately, with no rebuild.
		</p>
		<div class="table-scroll">
			<table class="table">
				<thead>
					<tr><th>Mode</th><th>Status</th><th>Use it when</th></tr>
				</thead>
				<tbody>
					<tr><td><strong>Live</strong></td><td>200</td><td>Normal.</td></tr>
					<tr>
						<td><strong>Coming soon</strong></td>
						<td>200</td>
						<td>Before launch — indexable and shareable.</td>
					</tr>
					<tr>
						<td><strong>Maintenance</strong></td>
						<td>503 + Retry-After</td>
						<td>Temporary downtime. Search engines keep the existing listing.</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p class="field__hint">
			<code>/login</code>, <code>/dashboard</code> and <code>/api</code> stay reachable in every mode, so you can
			always sign in and turn it back off — and so payment webhooks keep arriving.
		</p>
		<p class="field__hint">
			There is <strong>no admin bypass on public pages</strong>, and this is a property of prerendering rather than
			a setting: a prerendered route carries no session — even in <code>astro dev</code> — so there is no signed-in
			user to recognise. The bypass only applies to routes that render on demand.
		</p>
		<p class="field__hint">
			To keep working on the real site while it is gated, override WordPress locally by putting
			<code>SITE_MODE=live</code> in <code>web/.env</code>. The environment always wins, so your machine stays
			un-gated while production shows the notice. The same switch the other way —
			<code>SITE_MODE=maintenance</code> — is how you gate the site when WordPress itself is the thing that is down.
		</p>
		<p class="field__hint">
			A build started while the mode is not Live prints a warning, because the gate it bakes in stays until the
			next build.
		</p>
		<p class="field__hint">
			If WordPress itself is down, set <code>SITE_MODE=maintenance</code> in <code>web/.env</code>; the environment
			overrides WordPress. The gate also fails open: if WordPress cannot be reached, visitors see the site rather
			than a maintenance page.
		</p>
	</div>

	<div class="panel" id="keys">
		<h2 class="panel__title">Where API keys go</h2>
		<p>Two places, and the environment always wins:</p>
		<div class="table-scroll">
			<table class="table">
				<thead>
					<tr><th></th><th>Where</th><th>Best for</th></tr>
				</thead>
				<tbody>
					<tr>
						<td><strong>1</strong></td>
						<td><code>web/.env</code></td>
						<td>Production. Not in the database, not in backups, not readable from wp-admin.</td>
					</tr>
					<tr>
						<td><strong>2</strong></td>
						<td>
							<a href={`${wpOrigin}/wp-admin/options-general.php?page=app-settings`} target="_blank" rel="noopener noreferrer">
								Settings → App Settings
							</a>
						</td>
						<td>Rotating a key without redeploying. Saved secrets are shown masked.</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p class="field__hint">
			Changes made in wp-admin are picked up within 30 seconds; no restart needed. Keys set in
			<code>web/.env</code> cannot be overridden from wp-admin, which is the point.
		</p>
		{
			!isAdmin && (
				<p class="field__hint">
					You are signed in as a member, so the WordPress settings screen is not available to you.
				</p>
			)
		}
	</div>

	<div class="panel">
		<h2 class="panel__title">Local URLs</h2>
		<div class="table-scroll">
			<table class="table">
				<tbody>
					<tr><td>This site</td><td><code>{site.url}</code></td></tr>
					<tr><td>WordPress admin</td><td><code>{wpOrigin}/wp-admin</code></td></tr>
					<tr><td>GraphQL</td><td><code>{wpOrigin}/graphql</code></td></tr>
					<tr><td>REST</td><td><code>{wpOrigin}/wp-json/wp/v2</code></td></tr>
				</tbody>
			</table>
		</div>
	</div>
</DashboardLayout>
