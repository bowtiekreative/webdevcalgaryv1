---
/**
 * The free website teardown — the soft entry point.
 *
 * This used to be a $47 tripwire. With nothing sold on the site, its job
 * changes: it is now the offer for people who are not ready to talk about a
 * new website but will happily be told what is wrong with the one they have.
 *
 * It is still qualification. The same form, the same scoring, the same queue —
 * only the promise on the page differs, which is why it posts to the same
 * endpoint with its own `source` and gets its own follow-up.
 *
 * Giving the teardown away rather than charging for it costs the buyer-filter
 * the $47 used to provide. The score does that job instead.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkOrder from '../components/WorkOrder.astro';
import StartForm from '../components/StartForm.astro';
import { contact } from '../config';
import { teardownFindings } from '../funnel';
---

<BaseLayout
	title="Free website teardown"
	description="I'll record a walkthrough of your website and Google listing and show you exactly what's costing you calls. Free, and yours to keep."
	narrow
	startHref="#order"
	startLabel="Get it →"
>
	<section class="section hero">
		<div class="wrap wrap--narrow">
			<p class="eyebrow">The 24-hour website teardown · free</p>
			<h1>
				I’ll show you exactly<br /><em class="accent">what’s costing you calls.</em>
			</h1>
			<p class="lede hero__lede">
				I’ll record a video walking through your actual website and your Google listing, and point out
				everything that’s quietly losing you business. Usually it’s three or four things — and none of
				them are what people expect.
			</p>
			<div class="cta-row">
				<a class="btn btn--primary" href="#order">Get my teardown</a>
				<span class="mono">Video + fix list within 24 hours</span>
			</div>
		</div>
	</section>

	<section class="section section--concrete">
		<div class="wrap wrap--narrow">
			<WorkOrder
				serial="WC-047"
				rows={[
					{ label: '8–12 minute recorded walkthrough of your site', value: 'Included' },
					{ label: 'Your Google Business Profile, reviewed', value: 'Included' },
					{ label: 'One-page fix list, in plain English', value: 'Included' },
					{ label: 'Delivered within 24 hours', value: 'Included' },
				]}
				total={{ label: 'What it costs', value: '$0' }}
			>
				<b>The list is yours either way.</b> Take it to whoever you like — your own web person, another
				agency, or nobody. There is no invoice attached to it and no obligation to use us.
			</WorkOrder>
		</div>
	</section>

	<section class="section">
		<div class="wrap wrap--narrow">
			<h2>Why would I show you what’s wrong<br />instead of just selling you a site?</h2>
			<p class="lede why__lede">
				Because after twenty years, I know how this goes. Once you see the list — the wrong hours, the
				form that doesn’t send, the map listing pointing at your old address — you’ll want it fixed.
				Maybe by me, maybe by someone else. Either way, you stop losing calls.
			</p>
			<div class="grid">
				{
					teardownFindings.map((finding) => (
						<div class="card">
							<span class="card__index">{finding.index}</span>
							<h3>{finding.heading}</h3>
							<p>{finding.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="order" class="section section--ink">
		<div class="wrap wrap--narrow">
			<p class="eyebrow">Get yours</p>
			<h2>Send me your website.<br />I’ll send back the truth.</h2>
			<p class="lede order__lede">
				Video and fix list in your inbox within 24 hours. The questions below are so I know what I’m
				looking at before I hit record.
			</p>
			<div class="cols">
				<StartForm />
				<div class="alt">
					<h3>Rather just talk?</h3>
					<p>
						Call and I’ll tell you the first thing I’d fix, free, while you’re on the phone. No form,
						no recording, no follow-up sequence.
					</p>
					<a class="btn btn--block" href={`tel:${contact.phoneRaw}`}>Call {contact.phone} →</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 56px 0 32px;
	}

	h1 {
		font-size: clamp(2.2rem, 7vw, 3.8rem);
	}

	.hero__lede {
		margin-bottom: 30px;
	}

	h2 {
		font-size: clamp(1.7rem, 4.5vw, 2.6rem);
	}

	.why__lede {
		margin-bottom: 26px;
	}

	.order__lede {
		margin-bottom: 26px;
	}

	.alt {
		border: 1px solid var(--field-border);
		padding: 22px;
	}

	.alt h3 {
		margin: 0 0 10px;
		color: var(--paper);
	}

	.alt p {
		margin: 0 0 16px;
		color: #a8aeb8;
		font-size: 15px;
	}
</style>
