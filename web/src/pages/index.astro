---
/**
 * The funnel landing page.
 *
 * Section order is load-bearing and comes from 01-landing-page-strategy.md:
 * hero clock → proof numbers → the problem → peer proof → portfolio →
 * comparison → pricing → guarantee → start → FAQ. Peer proof sits above the
 * price because trades buy the person before they buy the plan.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DispatchClock from '../components/DispatchClock.astro';
import WorkOrder from '../components/WorkOrder.astro';
import PlanCard from '../components/PlanCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DemoCard from '../components/DemoCard.astro';
import AuthorityProof from '../components/AuthorityProof.astro';
import StartForm from '../components/StartForm.astro';
import demoSites from '../demo-sites.json';
import { contact, offers, plans, site, STANDARD_BUILD_DAYS } from '../config';
import { byMenuOrderThenDate } from '../lib/routes';
import { comparison, faqs, fallbackTestimonials, problems, proofStrip } from '../funnel';

const [testimonials, projects] = await Promise.all([
	getCollection('testimonials'),
	getCollection('projects'),
]);

const peerProof = testimonials.sort(byMenuOrderThenDate).slice(0, 6);
const featuredWork = projects.sort(byMenuOrderThenDate).slice(0, 6);

const rush = offers.rush;
const [core, growth] = plans;

const description =
	'Your new website, live tomorrow. Built in 24 hours, unlimited changes forever, and the price never goes up. Calgary trades and home services.';
---

<BaseLayout title={site.name} description={description}>
	<Fragment slot="head">
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'ProfessionalService',
				name: site.name,
				description,
				url: site.url,
				telephone: contact.phone,
				email: contact.email,
				areaServed: contact.serviceArea.map((name) => ({ '@type': 'City', name })),
				address: { '@type': 'PostalAddress', addressLocality: 'Calgary', addressRegion: 'AB', addressCountry: 'CA' },
				offers: {
					'@type': 'Offer',
					name: `${core.name} plan`,
					price: core.amount,
					priceCurrency: 'CAD',
				},
			})}
		/>
	</Fragment>

	<!-- Hero -->
	<section class="section hero">
		<div class="wrap">
			<p class="eyebrow">Calgary, AB · 403</p>
			<h1>Your new website.<br /><em class="accent">Live tomorrow.</em></h1>
			<p class="lede hero__lede">
				Built in 24 hours. Changed as often as you want, forever. Hosting, security and updates
				included — and the price never goes up.
			</p>
			<DispatchClock>
				Start now and your site is live by {'{deadline}'}. Miss that window and <b
					>the rush fee is refunded</b
				> — you keep the site.
			</DispatchClock>
			<div class="cta-row hero__cta">
				<a class="btn btn--primary" href="#start">Start my website</a>
				<a class="btn" href={`tel:${contact.phoneRaw}`}>Call {contact.phone}</a>
			</div>
			<p class="mono hero__terms">No contract · No lock-in · You own the site and the domain</p>
		</div>
	</section>

	<!-- Proof strip -->
	<div class="proof-strip">
		<div class="wrap proof-strip__grid">
			{
				proofStrip.map((item) => (
					<div>
						<b>{item.figure}</b>
						{item.label}
					</div>
				))
			}
		</div>
	</div>

	<!-- Problem -->
	<section class="section">
		<div class="wrap">
			<p class="eyebrow">Sound familiar?</p>
			<h2>The website isn’t the problem.<br />Nobody owning it is.</h2>
			<p class="lede">
				Most Calgary businesses don’t have a bad website. They have a website nobody has touched
				since it launched.
			</p>
			<div class="grid spaced">
				{
					problems.map((problem) => (
						<div class="card">
							<span class="card__index">{problem.index}</span>
							<h3>{problem.heading}</h3>
							<p>{problem.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Peer proof -->
	<section class="section section--concrete">
		<div class="wrap">
			<p class="eyebrow">From business owners</p>
			<h2>Ask them how long I’ve stuck around.</h2>
			<p class="lede">
				Anyone can build you a website. The question is whether they answer the phone in year three.
			</p>
			<div class="grid spaced" style="--col:300px">
				{
					peerProof.length > 0
						? peerProof.map((testimonial) => <TestimonialCard testimonial={testimonial} />)
						: fallbackTestimonials.map((item) => (
								<figure class="card quote">
									<blockquote>{item.quote}</blockquote>
									<figcaption>
										<b>{item.author}</b>
										{item.company ? ` · ${item.company}` : ''}
									</figcaption>
								</figure>
							))
				}
			</div>
			<AuthorityProof />
		</div>
	</section>

	<!-- Industry demos -->
	<section class="section">
		<div class="wrap">
			<p class="eyebrow">Your trade, your site</p>
			<h2>Fourteen industries.<br />Fourteen different sites.</h2>
			<p class="lede">
				You don’t want a template with your logo dropped in. A roofer’s site and a med spa’s site
				should not look the same. Open the one closest to your business — that’s the standard.
			</p>
			<div class="grid spaced" style="--col:220px">
				{demoSites.slice(0, 8).map((site) => <DemoCard site={site} />)}
			</div>
			<p class="mono more">
				<a href="/work">See all {demoSites.length} industries →</a>
			</p>
		</div>
	</section>

	<!-- Real client work, once there is some published -->
	{
		featuredWork.length > 0 && (
			<section class="section section--concrete">
				<div class="wrap">
					<p class="eyebrow">Still running</p>
					<h2>Sites we built. Sites we still maintain.</h2>
					<p class="lede">These are live right now. Click any of them — that’s the whole point.</p>
					<div class="grid spaced" style="--col:220px">
						{featuredWork.map((project) => (
							<ProjectCard project={project} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- Comparison -->
	<section class="section section--concrete">
		<div class="wrap">
			<p class="eyebrow">Straight comparison</p>
			<h2>What your other options actually cost.</h2>
			<div class="table-scroll spaced">
				<table class="table">
					<thead>
						<tr>
							<th></th>
							{
								comparison.columns.map((column, index) => (
									<th class:list={{ 'is-us': index === 0 }}>{column}</th>
								))
							}
						</tr>
					</thead>
					<tbody>
						{
							comparison.rows.map((row) => (
								<tr>
									<td>{row.label}</td>
									{row.values.map((value, index) => (
										<td class:list={{ 'is-us': index === 0 }}>{value}</td>
									))}
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section id="pricing" class="section">
		<div class="wrap">
			<p class="eyebrow">Pricing</p>
			<h2>You’re not paying for the website.<br />You’re paying for tomorrow.</h2>
			<p class="lede">
				The build is included. What costs money is jumping the queue and having it live by this time
				tomorrow.
			</p>
			<WorkOrder
				class="spaced"
				serial={rush.serial}
				rows={[
					{ label: 'Design and build', value: 'Included' },
					{ label: 'Copy, photos, mobile', value: 'Included' },
					{ label: 'Domain, SSL, launch', value: 'Included' },
				]}
				total={{ label: '24-hour rush fee', value: `$${rush.amount}` }}
			>
				Not in a rush? <b>Standard build is {STANDARD_BUILD_DAYS} days with no rush fee</b> — same
				site, same plan, you just wait. Most people don’t.
			</WorkOrder>

			<h3 class="plans__heading">Then pick a plan.</h3>
			<div class="plans">
				<PlanCard plan={core} href={`/checkout?plan=${core.id}`} />
				<PlanCard plan={growth} href={`/checkout?plan=${growth.id}`} />
			</div>
			<p class="notice spaced">
				<b>The price lock:</b> whatever you sign up at today is what you pay in ten years. No annual
				increases, no renewal bumps, no "your plan has changed" emails.
			</p>
		</div>
	</section>

	<!-- Guarantee -->
	<section class="section section--chinook">
		<div class="wrap">
			<p class="eyebrow">The guarantee</p>
			<h2>Live in 24 hours,<br />or the rush fee comes back.</h2>
			<p class="lede">
				Start before 2pm and your site is live by this time tomorrow. If we miss it, the ${rush.amount}
				is refunded — and you still keep the website. Then take 30 days. If it isn’t right, cancel and
				keep the site and the domain anyway.
			</p>
			<p class="lede small">
				Orders placed after 2pm MT start the next business day at 9am, live by 9am the day after.
				Weekend orders start Monday. You’ll get your exact go-live time in writing the moment payment
				clears.
			</p>
		</div>
	</section>

	<!-- Start -->
	<section id="start" class="section section--ink">
		<div class="wrap">
			<p class="eyebrow">Start here</p>
			<h2>Two ways to go.</h2>
			<p class="lede">
				Pay the rush fee and we start now — or send the details and I’ll call you back today.
			</p>
			<div class="cols spaced">
				<StartForm />
				<div class="alt">
					<h3>Or skip the form.</h3>
					<a class="alt__row" href={`tel:${contact.phoneRaw}`}>
						Call {contact.phone}<span>Fastest</span>
					</a>
					<a class="alt__row" href={`sms:${contact.phoneRaw}`}>
						Text me the details<span>SMS</span>
					</a>
					<a class="alt__row" href={`mailto:${contact.email}`}>
						{contact.email}<span>Email</span>
					</a>
					<div class="alt__cta">
						<a class="btn btn--hivis btn--block" href="/checkout">
							Pay the ${rush.amount} rush fee →
						</a>
						<p class="form__note">
							Starts the 24-hour clock the moment it clears. Refunded in full if we miss it.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="section">
		<div class="wrap">
			<p class="eyebrow">Questions</p>
			<h2 class="faq__heading">Asked and answered.</h2>
			<div class="faq">
				{
					faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 56px 0 20px;
	}

	.hero__lede {
		margin-bottom: 32px;
	}

	.hero__cta {
		margin-top: 30px;
	}

	.hero__terms {
		margin: 14px 0 0;
	}

	.proof-strip {
		background: var(--concrete);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		padding: 26px 0;
	}

	.proof-strip__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 22px;
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 1.5;
		color: var(--ink-2);
	}

	.proof-strip__grid b {
		display: block;
		font-family: var(--font-display);
		font-size: 26px;
		font-weight: 800;
		color: var(--ink);
		letter-spacing: -0.02em;
		margin-bottom: 2px;
	}

	.spaced {
		margin-top: 32px;
	}

	.more {
		margin: 16px 0 0;
	}

	.quote {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin: 0;
		padding: 26px 24px;
	}

	.quote blockquote {
		margin: 0;
		font-size: 15px;
		color: var(--ink);
		line-height: 1.7;
	}

	.quote figcaption {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-2);
		margin-top: auto;
	}

	.quote figcaption b {
		color: var(--ink);
	}

	.plans__heading {
		margin: 44px 0 6px;
		font-size: 21px;
	}

	.plans {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
		gap: 20px;
		margin-top: 20px;
	}

	.small {
		font-size: 15px;
		margin-top: 16px;
	}

	.alt {
		border: 1px solid var(--field-border);
		padding: 22px;
	}

	.alt h3 {
		margin: 0 0 16px;
		color: var(--paper);
	}

	.alt__row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 13px 0;
		border-bottom: 1px solid var(--field-border);
		color: var(--paper);
		font-size: 15px;
	}

	.alt__row:hover {
		color: var(--hivis);
	}

	.alt__row span {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--hivis);
	}

	.alt__cta {
		margin-top: 18px;
	}

	.faq__heading {
		margin-bottom: 26px;
	}
</style>
