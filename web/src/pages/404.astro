---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../config';
---

<BaseLayout title="Page not found" description="That page isn't here." nav>
	<section class="section">
		<div class="wrap">
			<p class="eyebrow">404</p>
			<h1>That page isn’t here.</h1>
			<p class="lede">
				It moved, or it never existed. Either way, nothing here is worth a dead end — the phone works.
			</p>
			<div class="cta-row cta">
				<a class="btn btn--primary" href="/">Back to the start</a>
				<a class="btn" href={`tel:${contact.phoneRaw}`}>Call {contact.phone}</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.cta {
		margin-top: 26px;
	}
</style>
