---
/**
 * A single service.
 */
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byMenuOrderThenDate } from '../../lib/routes';
import { contact } from '../../config';

interface Props {
	service: CollectionEntry<'services'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
	const services = (await getCollection('services')).sort(byMenuOrderThenDate);

	return services.map((service) => ({
		params: { slug: service.id },
		props: { service },
	}));
};

const { service } = Astro.props;
const { Content } = await render(service);
const { title, tagline, summary, bullets, startingPrice, seo } = service.data;
---

<BaseLayout title={title} description={tagline ?? summary} seo={seo} nav>
	<section class="section hero">
		<div class="wrap">
			<p class="eyebrow"><a href="/services">Services</a></p>
			<h1>{title}</h1>
			{(tagline || summary) && <p class="lede">{tagline ?? summary}</p>}
			{startingPrice && <p class="price price--lead">{startingPrice}</p>}
		</div>
	</section>

	<section class="section body">
		<div class="wrap cols">
			<div class="prose">
				<Content />
			</div>
			{
				bullets.length > 0 && (
					<div class="panel included">
						<div class="panel__bar">
							<span>Included</span>
							<span>{service.id.slice(0, 12).toUpperCase()}</span>
						</div>
						<div class="panel__body">
							{bullets.map((bullet) => (
								<div class="row">
									<span>{bullet}</span>
									<span class="row__value">Yes</span>
								</div>
							))}
						</div>
					</div>
				)
			}
		</div>
	</section>

	<section class="section section--ink">
		<div class="wrap">
			<h2>Want this done?</h2>
			<p class="lede">Call and describe the job. You’ll get a number, not a discovery call.</p>
			<div class="cta-row cta">
				<a class="btn btn--hivis" href={`tel:${contact.phoneRaw}`}>Call {contact.phone}</a>
				<a class="btn" href="/#start">Send the details</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 56px 0 24px;
	}

	h1 {
		font-size: clamp(2.1rem, 6vw, 3.4rem);
	}

	.price--lead {
		font-size: 30px;
		margin: 24px 0 0;
		color: var(--rust);
	}

	.body {
		--col: 300px;
	}

	.included {
		max-width: none;
	}

	.included .row:last-child {
		border-bottom: 0;
	}

	.cta {
		margin-top: 26px;
	}
</style>
