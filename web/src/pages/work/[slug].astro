---
/**
 * A single portfolio entry.
 *
 * The point of this page is not the design work — it is the years in the
 * "live since" line and the fact that the link at the bottom still resolves.
 */
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WpImage from '../../components/WpImage.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { byMenuOrderThenDate } from '../../lib/routes';
import { contact } from '../../config';

interface Props {
	project: CollectionEntry<'projects'>;
	others: Array<CollectionEntry<'projects'>>;
}

export const getStaticPaths: GetStaticPaths = async () => {
	const projects = (await getCollection('projects')).sort(byMenuOrderThenDate);

	return projects.map((project) => ({
		params: { slug: project.id },
		props: {
			project,
			others: projects.filter((candidate) => candidate.id !== project.id).slice(0, 3),
		},
	}));
};

const { project, others } = Astro.props;
const { Content } = await render(project);

const { title, summary, client, year, role, deliverables, externalUrl, hero, gallery, industries, seo } =
	project.data;

const trade = industries[0]?.name ?? null;

const facts = [
	client ? { label: 'Client', value: client } : null,
	trade ? { label: 'Industry', value: trade } : null,
	year ? { label: 'Live since', value: String(year) } : null,
	role ? { label: 'What we did', value: role } : null,
].filter((fact): fact is { label: string; value: string } => fact !== null);
---

<BaseLayout title={title} description={summary} seo={seo} type="article" nav>
	<article>
		<section class="section hero">
			<div class="wrap">
				{trade && <p class="eyebrow">{trade}</p>}
				<h1>{client ?? title}</h1>
				{summary && <p class="lede">{summary}</p>}

				{
					facts.length > 0 && (
						<dl class="facts">
							{facts.map((fact) => (
								<div>
									<dt>{fact.label}</dt>
									<dd>{fact.value}</dd>
								</div>
							))}
						</dl>
					)
				}

				{
					externalUrl && (
						<p class="visit">
							<a class="btn btn--primary" href={externalUrl} target="_blank" rel="noopener">
								Visit the live site →
							</a>
						</p>
					)
				}
			</div>
		</section>

		{
			hero && (
				<div class="wrap hero-image">
					<WpImage media={hero} sizes="(min-width: 1080px) 1036px, 100vw" eager />
				</div>
			)
		}

		<section class="section body">
			<div class="wrap">
				<div class="prose">
					<Content />
				</div>

				{
					deliverables.length > 0 && (
						<div class="deliverables">
							<h2>What was included</h2>
							<ul>
								{deliverables.map((item) => (
									<li>
										<span aria-hidden="true">→</span> {item}
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
		</section>

		{
			gallery.length > 0 && (
				<section class="section section--concrete">
					<div class="wrap gallery">
						{gallery.map((image) => (
							<WpImage media={image} sizes="(min-width: 720px) 50vw, 100vw" />
						))}
					</div>
				</section>
			)
		}
	</article>

	{
		others.length > 0 && (
			<section class="section">
				<div class="wrap">
					<p class="eyebrow">More work</p>
					<h2 class="more__heading">Other industries.</h2>
					<div class="grid" style="--col:240px">
						{others.map((other) => (
							<ProjectCard project={other} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section section--ink">
		<div class="wrap">
			<h2>Want one like this? It’s live tomorrow.</h2>
			<p class="lede">
				Same build, same maintenance, same price lock — and a straight answer on the phone
				before anything starts.
			</p>
			<div class="cta-row cta">
				<a class="btn btn--hivis" href="/#start">See if we’re a fit →</a>
				<a class="btn" href={`tel:${contact.phoneRaw}`}>Call {contact.phone}</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 56px 0 24px;
	}

	h1 {
		font-size: clamp(2.1rem, 6vw, 3.4rem);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 2px;
		background: var(--line);
		border: 1px solid var(--line);
		margin: 34px 0 0;
	}

	.facts > div {
		background: var(--paper);
		padding: 18px 20px;
	}

	dt {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--rust);
		margin-bottom: 6px;
	}

	dd {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 17px;
	}

	.visit {
		margin: 26px 0 0;
	}

	.hero-image {
		margin-top: 32px;
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		border: 2px solid var(--ink);
	}

	.body {
		padding-top: 40px;
	}

	.deliverables {
		margin-top: 44px;
	}

	.deliverables h2 {
		font-size: clamp(1.3rem, 3vw, 1.7rem);
	}

	.deliverables ul {
		list-style: none;
		margin: 16px 0 0;
		padding: 0;
		max-width: 60ch;
	}

	.deliverables li {
		font-size: 15px;
		color: var(--ink-2);
		padding: 9px 0;
		border-top: 1px solid var(--line);
	}

	.deliverables li span {
		color: var(--hivis);
		font-weight: 700;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 20px;
	}

	.gallery :global(img) {
		display: block;
		width: 100%;
		border: 1px solid var(--line);
	}

	.more__heading {
		margin-bottom: 26px;
	}

	.cta {
		margin-top: 26px;
	}
</style>
