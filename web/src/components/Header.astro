---
/**
 * Sticky funnel header. Two things only: the phone number and "Start →".
 *
 * The nav from WordPress is deliberately not rendered on funnel pages — every
 * extra link is another way to leave without starting. Pass `nav` to show it
 * (the portfolio index does).
 */
import Wordmark from './Wordmark.astro';
import { contact, fallbackNav } from '../config';

interface Props {
	/** Show the site nav alongside the phone/Start pair. */
	nav?: boolean;
	/** Where "Start →" points. */
	startHref?: string;
	narrow?: boolean;
}

const { nav = false, startHref = '/#start', narrow = false } = Astro.props;
---

<header class="site-header">
	<div class={narrow ? 'wrap wrap--narrow bar' : 'wrap bar'}>
		<Wordmark />
		<div class="bar__right">
			{
				nav && (
					<nav class="bar__nav">
						{fallbackNav.map((item) => (
							<a href={item.href}>{item.label}</a>
						))}
					</nav>
				)
			}
			<a class="phone" href={`tel:${contact.phoneRaw}`}>{contact.phone}</a>
			<a class="tick" href={startHref}>Start →</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--line);
		position: sticky;
		top: 0;
		background: rgba(255, 255, 255, 0.94);
		backdrop-filter: blur(8px);
		z-index: 50;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 62px;
		gap: 14px;
	}

	.bar__right {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	.bar__nav {
		display: flex;
		gap: 18px;
	}

	.bar__nav a {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
		color: var(--ink-2);
	}

	.bar__nav a:hover {
		color: var(--rust);
	}

	.phone {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
		color: var(--ink);
	}

	.phone:hover {
		color: var(--rust);
	}

	@media (max-width: 620px) {
		.bar__nav,
		.phone {
			display: none;
		}
	}
</style>
