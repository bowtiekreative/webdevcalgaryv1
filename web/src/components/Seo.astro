---
/**
 * Canonical URL, Open Graph and Twitter tags for a single page.
 *
 * Values come from the Meta Box "SEO & Social" group where an editor filled it
 * in, and fall back to the page's own title/excerpt otherwise.
 */
import type { Seo } from '../lib/wp/schema';

interface Props {
	title: string;
	description?: string | null;
	seo?: Seo | null;
	/** Overrides the social image when there is no SEO image. */
	image?: string | null;
	type?: 'website' | 'article';
	publishedTime?: string | null;
	modifiedTime?: string | null;
}

const {
	title,
	description = null,
	seo = null,
	image = null,
	type = 'website',
	publishedTime = null,
	modifiedTime = null,
} = Astro.props;

const siteName = 'Bow Tie Kreative';

const resolvedTitle = seo?.title || title;
const resolvedDescription = seo?.description || description || '';
const resolvedImage = seo?.image?.url || image;

const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site ?? Astro.url.origin);
const socialImage = resolvedImage ? new URL(resolvedImage, canonical) : null;

const fullTitle = resolvedTitle === siteName ? siteName : `${resolvedTitle} — ${siteName}`;
---

<title>{fullTitle}</title>
<link rel="canonical" href={canonical.href} />

{resolvedDescription && <meta name="description" content={resolvedDescription} />}
{seo?.noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={siteName} />
{resolvedDescription && <meta property="og:description" content={resolvedDescription} />}
{socialImage && <meta property="og:image" content={socialImage.href} />}
{seo?.image?.alt && <meta property="og:image:alt" content={seo.image.alt} />}

<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={resolvedTitle} />
{resolvedDescription && <meta name="twitter:description" content={resolvedDescription} />}
{socialImage && <meta name="twitter:image" content={socialImage.href} />}

{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
