---
/**
 * Mono footer on concrete. Address, phone, email, the one-line promise.
 */
import { contact, site } from '../config';

interface Props {
	narrow?: boolean;
}

const { narrow = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class={narrow ? 'wrap wrap--narrow' : 'wrap'}>
		<p>
			<strong>{site.name}</strong> · {contact.company} · {contact.address} ·{' '}
			<a href={`tel:${contact.phoneRaw}`}>{contact.phone}</a> ·{' '}
			<a href={`mailto:${contact.email}`}>{contact.email}</a>
		</p>
		<p>Websites live in 24 hours. Unlimited changes. Price locked for life.</p>
		<p>
			<a href="/work">Portfolio</a> · <a href="/teardown">$47 teardown</a> ·{' '}
			<a href="/blog">Journal</a> · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> ·{' '}
			<a href="/refund-policy">Refund policy</a>
			<span class="year"> · © {year}</span>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--concrete);
		border-top: 1px solid var(--line);
		padding: 34px 0;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--ink-2);
		line-height: 1.8;
	}

	.site-footer p {
		margin: 0;
	}

	.site-footer strong {
		color: var(--ink);
	}

	.site-footer a {
		color: var(--ink);
	}

	.site-footer a:hover {
		color: var(--rust);
	}

	.year {
		color: var(--ink-2);
	}
</style>
