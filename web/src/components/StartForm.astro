---
/**
 * The qualification form — the only conversion on the site.
 *
 * Nothing is sold here, so this is where the funnel earns its keep. Five
 * choice questions and four contact fields: enough to sort the callback queue,
 * short enough that a contractor finishes it on a phone between jobs.
 *
 * A plain POST to /api/leads/start, so it works with JavaScript off. The
 * script only adds a submitting state and surfaces errors inline rather than
 * navigating away. The audience reads this on LTE and a fetch-only form is one
 * more way to lose the lead.
 *
 * The questions are ordered by how easy they are to answer, not by how much we
 * want to know. Trade first (instant), money last (the one people hesitate on)
 * — asking for budget before earning it is how you get an abandoned form.
 */
import { budgets, roles, siteStates, timelines, trades } from '../config';

const questions = [
	{ name: 'trade', label: 'What kind of business?', options: trades },
	{ name: 'siteState', label: 'Where are you starting from?', options: siteStates },
	{ name: 'timeline', label: 'How soon do you need it?', options: timelines },
	{ name: 'role', label: 'Who am I speaking with?', options: roles },
	{ name: 'budget', label: 'What works for you monthly?', options: budgets },
];
---

<form class="form" method="POST" action="/api/leads/start" data-start-form>
	<input type="hidden" name="source" value={Astro.url.pathname} />
	<!-- Honeypot: bots fill it, people never see it. -->
	<input type="text" name="company_website" tabindex="-1" autocomplete="off" class="trap" aria-hidden="true" />

	<label class="sr-only" for="lead-name">Your name</label>
	<input id="lead-name" type="text" name="name" placeholder="Your name" required autocomplete="name" />

	<label class="sr-only" for="lead-business">Business name</label>
	<input
		id="lead-business"
		type="text"
		name="business"
		placeholder="Business name"
		required
		autocomplete="organization"
	/>

	<label class="sr-only" for="lead-phone">Phone</label>
	<input
		id="lead-phone"
		type="tel"
		name="phone"
		placeholder="Phone (403 / 587)"
		required
		autocomplete="tel"
	/>

	<label class="sr-only" for="lead-email">Email</label>
	<input id="lead-email" type="email" name="email" placeholder="Email" required autocomplete="email" />

	{
		questions.map((question) => (
			<>
				<label class="q" for={`lead-${question.name}`}>{question.label}</label>
				<select id={`lead-${question.name}`} name={question.name} required>
					<option value="">Pick one…</option>
					{question.options.map((option) => (
						<option value={option.id}>{option.label}</option>
					))}
				</select>
			</>
		))
	}

	<label class="sr-only" for="lead-website">Current website</label>
	<input id="lead-website" type="url" name="website" placeholder="Current website (if you have one)" />

	<label class="sr-only" for="lead-notes">What's the biggest problem?</label>
	<textarea
		id="lead-notes"
		name="notes"
		rows="3"
		placeholder="What's the one thing that bugs you most about it right now?"></textarea>

	<p class="form__error" data-error hidden></p>

	<button type="submit">Send it — call me back today</button>
	<p class="form__note">No card, no contract, no pitch deck. Just a straight answer.</p>
</form>

<style>
	.trap {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.q {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--hivis);
		margin-top: 6px;
	}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-start-form]').forEach((form) => {
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const error = form.querySelector<HTMLElement>('[data-error]');

		form.addEventListener('submit', async (event) => {
			if (!form.reportValidity()) {
				return;
			}

			event.preventDefault();

			const original = button?.textContent ?? '';

			if (button) {
				button.disabled = true;
				button.textContent = 'Sending…';
			}

			if (error) {
				error.hidden = true;
			}

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { Accept: 'application/json' },
					body: new FormData(form),
				});

				const payload = (await response.json()) as { ok?: boolean; error?: string; redirect?: string };

				if (!response.ok || !payload.ok) {
					throw new Error(payload.error || 'Something went wrong. Call us instead — we always pick up.');
				}

				window.location.href = payload.redirect ?? '/thank-you?lead=1';
			} catch (cause) {
				if (error) {
					error.textContent = cause instanceof Error ? cause.message : String(cause);
					error.hidden = false;
				}

				if (button) {
					button.disabled = false;
					button.textContent = original;
				}
			}
		});
	});
</script>
