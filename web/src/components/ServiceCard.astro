---
/**
 * A service, in the hairline card grid. Used by /services.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
	service: CollectionEntry<'services'>;
	index?: number;
}

const { service, index } = Astro.props;
const { title, path, tagline, summary, bullets, startingPrice } = service.data;
---

<a class="card service" href={path}>
	<span class="card__index">{index === undefined ? '·' : String(index + 1).padStart(2, '0')}</span>
	<h3>{title}</h3>
	<p>{tagline ?? summary}</p>
	{
		bullets.length > 0 && (
			<ul>
				{bullets.slice(0, 4).map((bullet) => (
					<li>
						<span aria-hidden="true">→</span> {bullet}
					</li>
				))}
			</ul>
		)
	}
	{startingPrice && <span class="service__price">{startingPrice}</span>}
</a>

<style>
	.service h3 {
		margin: 0 0 8px;
	}

	ul {
		list-style: none;
		margin: 16px 0 0;
		padding: 0;
	}

	li {
		font-size: 14px;
		color: var(--ink-2);
		padding: 6px 0;
		border-top: 1px solid var(--line);
	}

	li span {
		color: var(--hivis);
		font-weight: 700;
	}

	.service__price {
		display: block;
		margin-top: 16px;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 15px;
		color: var(--rust);
	}
</style>
