---
/**
 * Peer proof — a text testimonial from a business owner.
 *
 * From the design brief: peer proof is what closes trades, so it gets the
 * larger, more prominent treatment. Authority proof (the video endorsements)
 * is deliberately smaller and never stands alone — see AuthorityProof.astro.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
	testimonial: CollectionEntry<'testimonials'>;
}

const { testimonial } = Astro.props;
const { quote, author, role, company } = testimonial.data;

const attribution = [role, company].filter(Boolean).join(' · ');
---

<figure class="card quote">
	<blockquote>{quote}</blockquote>
	<figcaption>
		{author && <b>{author}</b>}
		{attribution && <span>{author ? ' · ' : ''}{attribution}</span>}
	</figcaption>
</figure>

<style>
	.quote {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin: 0;
		padding: 26px 24px;
	}

	blockquote {
		margin: 0;
		font-size: 15px;
		color: var(--ink);
		line-height: 1.7;
	}

	figcaption {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-2);
		margin-top: auto;
	}

	figcaption b {
		color: var(--ink);
	}
</style>
