---
/**
 * A portfolio entry — one Calgary industry, one live site.
 *
 * "These are live right now. Click any of them — that's the whole point." The
 * card links out to the real site when `externalUrl` is set, and to the case
 * study otherwise.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	/** Link straight out to the live site instead of the case study. */
	external?: boolean;
}

const { project, external = false } = Astro.props;
const { title, path, client, year, externalUrl, industries } = project.data;

const trade = industries[0]?.name ?? null;
const href = external && externalUrl ? externalUrl : path;
const isExternal = href === externalUrl;
const since = year ? `live since ${year}` : null;
const note = [trade, since].filter(Boolean).join(' · ');
---

<a
	class="card project"
	href={href}
	rel={isExternal ? 'noopener' : undefined}
	target={isExternal ? '_blank' : undefined}
>
	{trade && <span class="card__index">{trade}</span>}
	<strong>{client ?? title}</strong>
	<span class="project__note">{note || project.data.summary}{' '}<em aria-hidden="true">↗</em></span>
</a>

<style>
	.project {
		padding: 22px;
	}

	strong {
		display: block;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 17px;
		color: var(--ink);
		margin-bottom: 4px;
	}

	.project__note {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-2);
		display: block;
	}

	em {
		font-style: normal;
		color: var(--rust);
	}
</style>
