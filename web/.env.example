# Copy to web/.env

# --- Required -------------------------------------------------------------
# WPGraphQL endpoint. Matches the docker-compose stack's default port.
WP_GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# Public URL of this Astro site. Used for canonical URLs, sitemap and RSS.
SITE_NAME="Your Studio"
SITE_TAGLINE="Brand, web and creative studio."
SITE_URL=http://localhost:4321

# --- Optional -------------------------------------------------------------
# WordPress application password as "username:xxxx xxxx xxxx xxxx xxxx xxxx".
# Only needed to read drafts, private posts or restricted fields.
# Create one at: wp-admin → Users → Profile → Application Passwords
# WP_APPLICATION_PASSWORD=

# Fail the build when WordPress is unreachable instead of building with the
# previously cached content. Recommended in CI, left off locally.
# WP_FAIL_ON_ERROR=1

# Per-request timeout in milliseconds (default 20000).
# WP_REQUEST_TIMEOUT_MS=20000

# Must match APP_PREVIEW_SECRET in the root .env if you use draft previews.
# PREVIEW_SECRET=dev-preview-secret

# --- Dashboard auth ------------------------------------------------------
# Shared secret presented to WordPress's auth/billing REST API. Server-side
# only; the browser never sees it. Must match APP_SHARED_SECRET in ../.env
# Generate with:  openssl rand -hex 32
WP_SHARED_SECRET=

# --- Stripe (subscriptions) ----------------------------------------------
# Dashboard -> Developers -> API keys. Use sk_test_... while developing.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=
# Recurring price IDs (price_...), one per plan in src/config.ts.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=

# --- PayPal (subscriptions) ----------------------------------------------
# 'sandbox' (default) or 'live'. Anything but 'live' uses the sandbox API.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the app's webhook config — required to verify events.
PAYPAL_WEBHOOK_ID=
# Billing plan IDs (P-...), one per plan in src/config.ts.
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_STUDIO=

# --- Emailit (https://emailit.com) ---------------------------------------
EMAILIT_API_KEY=
EMAILIT_FROM="Your Studio <hello@example.com>"
# Messages per second. New workspaces are capped at 2/s and 5,000/day.
EMAILIT_RATE_LIMIT=2
