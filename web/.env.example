# Copy to web/.env
#
# Anything here can also be set in wp-admin under Settings → App Settings, which
# is how a key gets rotated without a redeploy. Env always wins — production
# secrets belong here (or in Coolify), not in the database.

# --- Required -------------------------------------------------------------
# WPGraphQL endpoint. Matches the docker-compose stack's default port.
WP_GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# Public identity. SITE_URL is used for canonical URLs, the sitemap and RSS.
SITE_NAME="WebDevCalgary"
SITE_TAGLINE="Websites live in 24 hours. Unlimited changes. Price locked for life."
SITE_URL=http://localhost:4321

# Shown on the site, and used as Reply-To on everything we send.
SITE_PHONE="(888) 755-0507"
SITE_PHONE_RAW=8887550507
SITE_EMAIL=hello@webdevcalgary.com

# Where new orders and leads are announced. Defaults to SITE_EMAIL.
SALES_NOTIFY_EMAIL=websites@bowtiekreative.com

# --- Optional -------------------------------------------------------------
# WordPress application password as "username:xxxx xxxx xxxx xxxx xxxx xxxx".
# Only needed to read drafts, private posts or restricted fields.
# Create one at: wp-admin → Users → Profile → Application Passwords
# WP_APPLICATION_PASSWORD=

# Fail the build when WordPress is unreachable instead of building with the
# previously cached content. Set this in CI and in production.
# WP_FAIL_ON_ERROR=1

# Per-request timeout in milliseconds (default 20000).
# WP_REQUEST_TIMEOUT_MS=20000

# Must match PREVIEW_SECRET in the root .env if you use draft previews.
# PREVIEW_SECRET=dev-preview-secret

# --- Dashboard auth ------------------------------------------------------
# Shared secret presented to WordPress's auth/billing/orders REST API. Server
# side only; the browser never sees it. Must match APP_SHARED_SECRET in ../.env
# Generate with:  openssl rand -hex 32
WP_SHARED_SECRET=

# --- PayPal --------------------------------------------------------------
# The funnel's payment provider, used two ways:
#
#   Orders API (/v2/checkout)  — one-time charges: the $497 rush fee, the $47
#                                teardown, the $97 GBP bump, the $297 rescue.
#                                Nothing to configure beyond the credentials;
#                                prices come from web/src/config.ts.
#   Subscriptions API (/v1/billing) — the $147 Core and $497 Growth plans.
#                                Each needs a billing plan created in PayPal,
#                                and its P-... id set below.
#
# 'sandbox' (default) or 'live'. Anything but exactly 'live' uses the sandbox,
# so a typo cannot charge real cards.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the app's webhook config — required to verify events.
PAYPAL_WEBHOOK_ID=
# Billing plan IDs (P-...), one per plan in src/config.ts.
PAYPAL_PLAN_CORE=
PAYPAL_PLAN_GROWTH=

# --- Stripe (optional second provider) -----------------------------------
# Wired up and working, but PayPal is the one the funnel uses. Leave blank to
# hide Stripe from the dashboard's billing page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE=
STRIPE_PRICE_GROWTH=

# --- Emailit (https://emailit.com) ---------------------------------------
# Order confirmations, lead acknowledgements and the internal notifications.
#
# EMAILIT_FROM must be on a domain verified in Emailit. bowtiekreative.com is
# verified; webdevcalgary.com is not yet. Once it is, move this over — a
# From: on the same domain as the site converts better.
EMAILIT_API_KEY=
EMAILIT_FROM="WebDevCalgary <websites@bowtiekreative.com>"
# Messages per second. New workspaces are capped at 2/s and 5,000/day.
EMAILIT_RATE_LIMIT=2
