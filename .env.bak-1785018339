# Copy to .env — consumed by docker-compose.yml (the WordPress/MySQL stack).
# The Astro front end has its own env file at web/.env (see web/.env.example).

# --- MySQL ---------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
# Host port for the database (3307 avoids clashing with a local MySQL).
MYSQL_PORT=3307

# --- WordPress -----------------------------------------------------------
WORDPRESS_PORT=8080
WORDPRESS_DEBUG=1

# Where the Astro front end runs. WordPress redirects its own front end here
# and rewrites permalinks/preview links to point at it.
FRONTEND_URL=http://localhost:4321

# Shared secret for draft previews. Must match PREVIEW_SECRET in web/.env.
PREVIEW_SECRET=dev-preview-secret

# Optional deploy hook. If set, WordPress POSTs to it when content is
# published so your host rebuilds the static site.
BUILD_HOOK_URL=http://host.docker.internal:4321/_refresh

# --- Used by scripts/wp-bootstrap.sh ------------------------------------
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=ryan@bowtiekreative.com
WP_SITE_TITLE="Bow Tie Kreative"

# Pins this checkout to the pre-existing "btk" stack and its volumes.
# New checkouts can leave this unset and get the docker-compose.yml default.
COMPOSE_PROJECT_NAME=btk
