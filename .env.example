# Copy to .env — consumed by docker-compose.yml (the WordPress/MySQL stack).
# The Astro front end has its own env file at web/.env (see web/.env.example).
#
# The credentials below are throwaway defaults for local development, and the
# compose stack only publishes ports on localhost. Change every one of them
# before this runs anywhere reachable from another machine.

# --- MySQL ---------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
# Host port for the database (3307 avoids clashing with a local MySQL).
MYSQL_PORT=3307

# --- WordPress -----------------------------------------------------------
WORDPRESS_PORT=8080
WORDPRESS_DEBUG=1

# 'local' | 'development' | 'staging' | 'production'.
# Keep 'local' for this stack: WordPress refuses to issue or accept application
# passwords over plain HTTP otherwise, which breaks REST writes. On a real host
# use 'production' — HTTPS enables them there.
WP_ENVIRONMENT_TYPE=local

# Where the Astro front end runs. WordPress redirects its own front end here
# and rewrites permalinks/preview links to point at it.
FRONTEND_URL=http://localhost:4321

# Shared secret for draft previews. Must match PREVIEW_SECRET in web/.env.
PREVIEW_SECRET=dev-preview-secret

# Deploy hook. WordPress POSTs to this whenever published content changes.
#
# In local dev, point it at the Astro dev server's refresh endpoint and saving a
# post updates the running site immediately (otherwise the dev server polls
# every 5s — see web/integrations/wp-dev-refresh.mjs). `host.docker.internal`
# is how the container reaches your host.
BUILD_HOOK_URL=http://host.docker.internal:4321/_refresh

# In production this should instead be your host's build hook, e.g.
# BUILD_HOOK_URL=https://api.netlify.com/build_hooks/xxxxxxxx

# --- Dashboard auth ------------------------------------------------------
# Shared secret the Astro *server* presents to WordPress's auth/billing REST
# API. The browser never sees it. Must match WP_SHARED_SECRET in web/.env.
# Generate one with:  openssl rand -hex 32
APP_SHARED_SECRET=

# --- Emailit (https://emailit.com) --------------------------------------
# Used here for WordPress's own transactional mail (password resets). The
# dashboard's marketing features read the same key from web/.env.
EMAILIT_API_KEY=
EMAILIT_FROM="Your Studio <hello@example.com>"

# --- Used by scripts/wp-bootstrap.sh ------------------------------------
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_TITLE="Your Studio"
